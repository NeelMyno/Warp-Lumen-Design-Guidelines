    { "name": "Hazmat", "args": { "id": "PAL-9921", "weightLbs": 620, "dims": { "l": 48, "w": 40, "h": 48 }, "freightClass": 175, "hazmat": true, "lane": { "origin": "ORD", "destination": "ATL" } }, "children": "" }
  ],
  "variants": ["default", "compact", "hazmat"],
  "propsList": [
