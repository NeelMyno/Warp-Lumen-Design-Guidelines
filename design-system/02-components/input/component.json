{
  "$schema": "../_schema/component.schema.json",
  "name": "Input",
  "version": "0.1.0",
  "status": "stable",
  "deprecated": false,
  "summary": "A single-line text input. The base of every text-entry form control.",
  "props": {
    "size":         { "type": "enum", "values": ["sm", "md", "lg"], "default": "md", "optional": true },
    "mono":         { "type": "boolean", "default": false, "optional": true, "description": "Render value in JetBrains Mono with tabular numerics. Use for IDs, ZIPs, codes." },
    "error":        { "type": "boolean", "default": false, "optional": true },
    "disabled":     { "type": "boolean", "default": false, "optional": true },
    "readOnly":     { "type": "boolean", "default": false, "optional": true },
    "leadingIcon":  { "type": "icon", "optional": true },
    "trailingIcon": { "type": "icon", "optional": true },
    "placeholder":  { "type": "string", "optional": true, "description": "Hint, not a substitute for a label." },
    "value":        { "type": "string", "optional": true },
    "onChange":     { "type": "handler", "optional": false }
  },
  "tokens": {
    "consumed": [
      "input.height.sm", "input.height.md", "input.height.lg",
      "input.padding.x", "input.radius",
      "input.background.rest", "input.background.disabled",
      "input.border.rest", "input.border.hover", "input.border.focus", "input.border.error",
      "input.foreground.value", "input.foreground.placeholder",
      "shadow.focus", "type.body.md", "type.code.inline",
      "motion.transition.fast"
    ]
  },
  "a11y": {
    "keyboard": [
      "Tab - move focus to next control",
      "Shift+Tab - move focus to previous control"
    ],
    "wcag": [
      "1.3.1 Info and Relationships",
      "1.4.3 Contrast (Minimum)",
      "2.4.6 Headings and Labels",
      "3.3.1 Error Identification",
      "3.3.2 Labels or Instructions",
      "4.1.2 Name, Role, Value"
    ],
    "rules": [
      "Always paired with a visible label via Field, or with aria-label.",
      "Errors announced via aria-describedby pointing to a helper element with role=alert.",
      "Required marked via aria-required=true AND a visual indicator.",
      "Validation fires on blur, not on every keystroke.",
      "Submit failure moves focus to the first invalid field."
    ]
  },
  "rules": {
    "do": [
      "Always pair with a visible label.",
      "Use mono=true for codes, IDs, ZIPs.",
      "Set inputMode and autoComplete for known input types."
    ],
    "dont": [
      "Don't use placeholder as the only label.",
      "Don't validate on every keystroke.",
      "Don't suppress browser autofill."
    ]
  },
  "examples": { "web-react": "./examples/primary.tsx" },
  "related": ["Field", "Select", "Textarea", "Toggle"],
  "changelog": [
    { "version": "0.1.0", "type": "Added", "note": "Initial release." }
  ]
}
