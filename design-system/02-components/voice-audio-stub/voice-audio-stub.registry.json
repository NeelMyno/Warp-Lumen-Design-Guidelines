    "tier": "T5",
    "family": "VoiceAudio",
    "phase": 5,
    "vercelAIElements": {
      "name": "AudioPlayer",
      "installCommand": "npx ai-elements@latest add audio-player"
    },
    "platforms": [
      "web-react"
    ]
