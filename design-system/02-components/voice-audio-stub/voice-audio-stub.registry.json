{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "voice-audio-stub",
  "type": "registry:ui",
  "title": "VoiceAudio",
  "description": "STUB. Voice & Audio family entry point (AudioPlayer + Transcription + VoiceSelector + SpeechInput + MicSelector). Marked experimental until a Warp surface needs voice; flesh out at that point.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@lumen/utils",
    "@lumen/lumen-base"
