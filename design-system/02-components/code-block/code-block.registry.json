      "path": "design-system/02-components/code-block/code-block.tsx",
      "type": "registry:ui",
      "target": "components/ai-elements/code-block.tsx"
    }
  ],
  "cssVars": {
    "light": {},
    "dark": {}
  },
  "meta": {
    "lumenVersion": "0.13.0",
    "tier": "T5",
    "family": "Content",
    "phase": 5,
    "vercelAIElements": {
      "name": "CodeBlock",
      "installCommand": "npx ai-elements@latest add code-block"
    },
    "platforms": [
      "web-react"
