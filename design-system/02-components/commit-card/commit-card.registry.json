      "type": "registry:ui",
      "target": "components/ai-elements/commit.tsx"
    }
  ],
  "cssVars": {
    "light": {},
    "dark": {}
  },
  "meta": {
    "lumenVersion": "0.13.0",
    "tier": "T5",
    "family": "AgentTask",
    "phase": 5,
    "vercelAIElements": {
      "name": "Commit",
      "installCommand": "npx ai-elements@latest add commit"
    },
    "platforms": [
      "web-react"
    ]
