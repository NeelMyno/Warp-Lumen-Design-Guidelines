{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "commit-card",
  "type": "registry:ui",
  "title": "Commit",
  "description": "Commit / change card showing what the agent modified: title, diff summary, file count, revert affordance.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@lumen/utils",
    "@lumen/lumen-base"
  ],
  "files": [
    {
