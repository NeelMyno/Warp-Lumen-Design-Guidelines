{
  "$schema": "https://storybook.js.org/schema/component-manifest.json",
  "name": "textarea",
  "title": "Textarea",
  "description": "Token-driven multi-line text input with auto-grow via field-sizing.",
  "props": [
    {
      "name": "placeholder",
      "type": "string"
    },
    {
      "name": "disabled",
      "type": "boolean"
    },
    {
      "name": "aria-invalid",
      "type": "boolean"
    }
  ],
  "variants": [
    "default",
    "disabled",
    "error"
  ],
  "tokensConsumed": [
    "surface.input.rest",
    "surface.input.disabled",
    "border.default",
    "border.strong",
    "border.focus",
    "border.error",
    "border.input.disabled",
    "text.primary",
    "text.placeholder",
    "text.disabled",
    "shadow.input.lit-edge",
    "shadow.input.focus",
    "shadow.input.error",
    "radius.md",
    "motion.duration.fast",
    "motion.easing.standard"
  ],
  "a11y": {
    "wcag": "2.2-AA",
    "rules": [
      "Pair with <Label htmlFor> in <Field>, or supply aria-label / aria-labelledby.",
      "Use aria-describedby when paired with a ValidationMessage.",
      "aria-invalid triggers the error halo."
    ]
  },
  "usage": "import { Textarea } from \"@/components/ui/textarea\";\n\nexport function Example() {\n  return <Textarea placeholder=\"Pickup notes…\" />;\n}",
  "storiesPath": "02-components/textarea/textarea.stories.tsx",
  "sourcePath": "02-components/textarea/textarea.tsx",
  "lumenVersion": "0.13.0",
  "tier": "T1"
}
