{
  "$schema": "../_schema/component.schema.json",
  "name": "Select",
  "version": "0.6.0",
  "status": "stable",
  "deprecated": false,
  "summary": "Single-choice dropdown from a known list of options. Built on Radix Select for keyboard nav, type-ahead, popover positioning, and screen-reader semantics.",
  "props": {
    "value":         { "type": "string", "optional": true },
    "defaultValue":  { "type": "string", "optional": true },
    "onValueChange": { "type": "handler", "optional": true },
    "options":       { "type": "node", "optional": true, "description": "Composed via SelectItem children (Radix pattern)." },
    "placeholder":   { "type": "string", "optional": true },
    "size":          { "type": "enum", "values": ["sm", "default"], "default": "default", "optional": true },
    "disabled":      { "type": "boolean", "default": false, "optional": true },
    "name":          { "type": "string", "optional": true, "description": "Form field name for native form submission." }
  },
  "tokens": {
    "consumed": [
      "select.trigger.caretColor",
      "select.listbox.background", "select.listbox.border", "select.listbox.radius", "select.listbox.shadow", "select.listbox.minWidth", "select.listbox.maxHeight", "select.listbox.padding",
      "select.item.height", "select.item.padding.x", "select.item.padding.y", "select.item.radius", "select.item.type",
      "select.item.background.rest", "select.item.background.hover", "select.item.background.active", "select.item.background.selected",
      "select.item.color.rest", "select.item.color.active", "select.item.color.selected",
      "select.item.indicator",
      "input.height.sm", "input.height.md",
      "input.padding.x.md",
      "input.radius",
      "input.background.rest", "input.background.disabled",
      "input.border.rest", "input.border.hover", "input.border.focus", "input.border.error", "input.border.disabled",
      "input.foreground.value", "input.foreground.placeholder", "input.foreground.iconTrailing",
      "input.ring.focus", "input.ring.error", "input.ring.litEdge",
      "input.transition"
    ]
  },
  "a11y": {
    "keyboard": [
      "Tab — focus the trigger",
      "Space / Enter — open the listbox",
      "ArrowDown / ArrowUp — move highlight",
      "Home / End — first / last option",
      "A–Z — type-ahead",
      "Enter — select highlighted",
      "Escape — close without selecting"
    ],
    "minTouchTarget": "44x44",
    "wcag": [
      "1.3.1 Info and Relationships",
      "1.4.3 Contrast (Minimum)",
      "2.1.1 Keyboard",
      "2.4.3 Focus Order",
      "2.4.7 Focus Visible",
      "3.3.2 Labels or Instructions",
      "4.1.2 Name, Role, Value"
    ],
    "rules": [
      "Always paired with a visible label via Field, or with aria-label.",
      "Listbox renders in a portal — verify it escapes overflow:hidden ancestors (Radix handles this).",
      "Native form submission via `name` prop attaches Radix's hidden <input> to the form."
    ]
  },
  "rules": {
    "do": [
      "Use Select for known, stable lists of < 12 options.",
      "Use Combobox for searchable / dynamic lists.",
      "Order options alphabetically OR by frequency (whichever is more useful for the user); never random."
    ],
    "dont": [
      "Don't use Select for boolean — use Switch.",
      "Don't use Select for mutually-exclusive of 2-3 options when they all fit on one row — use Segmented.",
      "Don't disable Select options without an explanation; consider hiding them instead."
    ]
  },
  "examples": { "web-react": "../../../audit-dashboard/src/components/ui/select.tsx" },
  "related": ["Field", "Combobox", "RadioGroup", "Segmented"],
  "changelog": [
    { "version": "0.6.0", "type": "Added", "note": "Initial release. Replaces the v0.5 dual-implementation drift (custom native <select> in inputs.tsx vs unused shadcn Radix Select) — Radix Select is now canonical. Bug fix: removed `bg-transparent` that was clobbering the field-shell bg color." }
  ]
}
