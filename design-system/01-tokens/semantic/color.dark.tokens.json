{
  "$schema": "https://design-tokens.github.io/community-group/format/tokens.schema.json",
  "color": {
    "$type": "color",
    "$description": "SEMANTIC color tokens — dark mode. Mirrors color.light.tokens.json key paths with Warp's actual navy ladder values.",
    "surface": {
      "page":    { "$value": "{color.brand.900}", "$description": "Warp --warp-bg #131c2a" },
      "raised":  { "$value": "{color.brand.700}", "$description": "Warp --warp-surface-2 #1a2332" },
      "sunken":  { "$value": "{color.brand.800}", "$description": "Warp --warp-surface-1 #141c2b" },
      "overlay": { "$value": "rgba(26,35,50,0.86)" },
      "scrim":   { "$value": "rgba(0,0,0,0.6)" },
      "inverse": { "$value": "{color.warm.50}" }
    },
    "text": {
      "primary":   { "$value": "#f0f2f5", "$description": "Warp --warp-text" },
      "secondary": { "$value": "#b0b8c4", "$description": "Warp --warp-text-muted" },
      "tertiary":  { "$value": "#7a8494", "$description": "Warp --warp-text-dim" },
      "disabled":  { "$value": "{color.brand.500}" },
      "inverse":   { "$value": "{color.brand.900}" },
      "accent":    { "$value": "{color.accent.400}", "$description": "Brighter green works on dark." },
      "link":      { "$value": "#f0f2f5" }
    },
    "border": {
      "subtle":  { "$value": "rgba(255,255,255,0.06)" },
      "default": { "$value": "{color.brand.600}", "$description": "Warp --warp-border #253040" },
      "strong":  { "$value": "{color.brand.500}", "$description": "Warp --warp-border-strong #334155" },
      "focus":   { "$value": "{color.accent.400}" }
    },
    "action": {
      "primary": {
        "bg": {
          "rest":  { "$value": "{color.accent.500}" },
          "hover": { "$value": "{color.accent.600}" },
          "press": { "$value": "{color.accent.700}" }
        },
        "fg":   { "$value": "{color.accent.fg}" },
        "glow": { "$value": "{shadow.accent-glow}" }
      },
      "secondary": {
        "bg": {
          "rest":  { "$value": "{color.brand.700}" },
          "hover": { "$value": "{color.brand.600}" },
          "press": { "$value": "{color.brand.600}" }
        },
        "fg":     { "$value": "#f0f2f5" },
        "border": { "$value": "{color.brand.600}" }
      },
      "tertiary": {
        "bg": {
          "rest":  { "$value": "transparent" },
          "hover": { "$value": "rgba(255,255,255,0.06)" },
          "press": { "$value": "rgba(255,255,255,0.06)" }
        },
        "fg": { "$value": "#f0f2f5" }
      },
      "danger": {
        "bg": {
          "rest":  { "$value": "{color.status.danger.500}" },
          "hover": { "$value": "{color.status.danger.700}" }
        },
        "fg": { "$value": "#ffffff" }
      }
    },
    "status": {
      "success": { "bg": { "$value": "{color.status.success.900}" }, "fg": { "$value": "{color.accent.300}" } },
      "warning": { "bg": { "$value": "{color.status.warning.900}" }, "fg": { "$value": "#f3d8a4" } },
      "danger":  { "bg": { "$value": "{color.status.danger.900}"  }, "fg": { "$value": "#f4c0bb" } },
      "info":    { "bg": { "$value": "{color.status.info.900}"    }, "fg": { "$value": "#b9d0ff" } }
    }
  }
}
