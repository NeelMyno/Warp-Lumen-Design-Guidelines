{
  "$schema": "https://design-tokens.github.io/community-group/format/tokens.schema.json",
  "shadow": {
    "$type": "shadow",
    "$description": "Hairline borders do most of the surface separation work in Lumen. Shadows are reserved for floating UI (popover, dropdown, modal, toast). Light-mode values; dark mode overrides via semantic.",
    "xs": {
      "$value": [
        { "color": "rgba(14,18,25,0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "1px",  "spread": "0px" }
      ]
    },
    "sm": {
      "$value": [
        { "color": "rgba(14,18,25,0.05)", "offsetX": "0px", "offsetY": "1px", "blur": "2px",  "spread": "0px" },
        { "color": "rgba(14,18,25,0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "3px",  "spread": "0px" }
      ]
    },
    "md": {
      "$value": [
        { "color": "rgba(14,18,25,0.05)", "offsetX": "0px", "offsetY": "2px",  "blur": "4px",  "spread": "0px" },
        { "color": "rgba(14,18,25,0.05)", "offsetX": "0px", "offsetY": "4px",  "blur": "12px", "spread": "0px" }
      ]
    },
    "lg": {
      "$value": [
        { "color": "rgba(14,18,25,0.05)", "offsetX": "0px", "offsetY": "4px",  "blur": "8px",  "spread": "0px" },
        { "color": "rgba(14,18,25,0.06)", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "0px" }
      ]
    },
    "xl": {
      "$value": [
        { "color": "rgba(14,18,25,0.06)", "offsetX": "0px", "offsetY": "8px",  "blur": "16px", "spread": "0px" },
        { "color": "rgba(14,18,25,0.08)", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "0px" }
      ]
    },
    "2xl": {
      "$value": [
        { "color": "rgba(14,18,25,0.06)", "offsetX": "0px", "offsetY": "16px", "blur": "32px", "spread": "0px" },
        { "color": "rgba(14,18,25,0.10)", "offsetX": "0px", "offsetY": "40px", "blur": "80px", "spread": "0px" }
      ]
    },
    "inset": {
      "$value": [
        { "color": "rgba(14,18,25,0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "1px", "spread": "0px", "inset": true }
      ]
    },
    "accent-glow": {
      "$value": [
        { "color": "rgba(74,222,128,0.24)", "offsetX": "0px", "offsetY": "14px", "blur": "34px", "spread": "0px" }
      ],
      "$description": "Warp's signature green-glow under primary CTAs. Verbatim from Warp production CSS."
    }
  }
}
