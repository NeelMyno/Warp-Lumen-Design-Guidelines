{
  "$schema": "https://design-tokens.github.io/community-group/format/tokens.schema.json",
  "button": {
    "$description": "Component-bound tokens for the Button. Use these only inside Button code; for everything else, use the action.* semantics.",
    "height": {
      "$type": "dimension",
      "sm":   { "$value": "{size.control.sm}" },
      "cozy": { "$value": "{size.control.cozy}", "$description": "v0.8 — 36 px settings-panel sweet spot." },
      "md":   { "$value": "{size.control.md}" },
      "lg":   { "$value": "{size.control.lg}" },
      "xl":   { "$value": "{size.control.xl}",   "$description": "v0.8 — 56 px hero pill CTA." }
    },
    "padding": {
      "$description": "v0.8 — Migrated from raw px to semantic refs. Was hardcoded 12/16/20 — violated AGENTS.md hard rule #2 inside the token system itself.",
      "$type": "dimension",
      "sm": { "$value": "{space.3}", "$description": "12 px x — sm button" },
      "md": { "$value": "{space.4}", "$description": "16 px x — md button (default)" },
      "lg": { "$value": "{space.5}", "$description": "20 px x — lg button" },
      "xl": { "$value": "{space.8}", "$description": "v0.8 — 32 px x — xl hero pill CTA" }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.inline.sm}",
      "$description": "Gap between leading icon and label, etc."
    },
    "radius": { "$type": "dimension", "$value": "{radius.control.md}" },
    "intent": {
      "primary": {
        "background": {
          "rest":  { "$value": "{color.action.primary.bg.rest}" },
          "hover": { "$value": "{color.action.primary.bg.hover}" },
          "press": { "$value": "{color.action.primary.bg.press}" }
        },
        "foreground": { "$value": "{color.action.primary.fg}" },
        "shadow":     { "$value": "{shadow.accent-glow}" }
      },
      "secondary": {
        "background": {
          "rest":  { "$value": "{color.action.secondary.bg.rest}" },
          "hover": { "$value": "{color.action.secondary.bg.hover}" },
          "press": { "$value": "{color.action.secondary.bg.press}" }
        },
        "foreground": { "$value": "{color.action.secondary.fg}" },
        "border":     { "$value": "{color.action.secondary.border}" }
      },
      "tertiary": {
        "background": {
          "rest":  { "$value": "{color.action.tertiary.bg.rest}" },
          "hover": { "$value": "{color.action.tertiary.bg.hover}" },
          "press": { "$value": "{color.action.tertiary.bg.press}" }
        },
        "foreground": { "$value": "{color.action.tertiary.fg}" }
      },
      "danger": {
        "background": {
          "rest":  { "$value": "{color.action.danger.bg.rest}" },
          "hover": { "$value": "{color.action.danger.bg.hover}" }
        },
        "foreground": { "$value": "{color.action.danger.fg}" }
      }
    }
  }
}
