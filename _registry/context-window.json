{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-window",
  "type": "registry:ui",
  "title": "Context",
  "description": "Token usage / context window display. Composition of Stat (tokens used / limit) + horizontal progress meter. Color shifts to amber at 80%, lumen-red at 95%.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@lumen/utils",
    "@lumen/lumen-base"
  ],
  "files": [
    {
      "path": "design-system/02-components/context-window/context-window.tsx",
      "type": "registry:ui",
      "target": "components/ai-elements/context.tsx"
    }
  ],
  "cssVars": {
    "light": {},
    "dark": {}
  },
  "meta": {
    "lumenVersion": "0.13.0",
    "tier": "T5",
    "family": "Shared",
    "phase": 5,
    "vercelAIElements": {
      "name": "Context",
      "installCommand": "npx ai-elements@latest add context"
    },
    "platforms": [
      "web-react"
    ]
  }
}
