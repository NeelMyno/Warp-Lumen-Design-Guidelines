{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "terminal",
  "type": "registry:ui",
  "title": "Terminal",
  "description": "Console output with ANSI color support, streaming indicators, auto-scroll. Use for live tool-call output (sandbox stdout, deployment logs).",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@lumen/utils",
    "@lumen/lumen-base"
  ],
  "files": [
    {
      "path": "design-system/02-components/terminal/terminal.tsx",
      "type": "registry:ui",
      "target": "components/ai-elements/terminal.tsx"
    }
  ],
  "cssVars": {
    "light": {},
    "dark": {}
  },
  "meta": {
    "lumenVersion": "0.13.0",
    "tier": "T5",
    "family": "Content",
    "phase": 5,
    "vercelAIElements": {
      "name": "Terminal",
      "installCommand": "npx ai-elements@latest add terminal"
    },
    "platforms": [
      "web-react"
    ]
  }
}
